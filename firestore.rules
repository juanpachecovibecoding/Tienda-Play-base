rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isRoot() {
      return request.auth != null && (request.auth.token.email == "juanpacheco@playcode.com.ar" || request.auth.token.email == "juanpacheco.vibecoding@gmail.com");
    }
    
    function isAdmin() {
      return isRoot() || (request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin" || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "superadmin"));
    }

    function isStaff() {
      return isAdmin() || (request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "seller");
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      // Any authenticated user can read their own profile.
      allow read: if request.auth != null && request.auth.uid == userId;
      // Admins can read all users
      allow read, write: if isAdmin();
      // Allow users to create their own profile as 'seller'
      allow create: if request.auth != null && request.auth.uid == userId && request.resource.data.role == "seller";
    }

    match /products/{productId} {
      allow read: if isStaff();
      // Sellers can update products (to reduce stock when making a sale)
      allow update: if isStaff();
      // Only admins can create or delete products
      allow create, delete: if isAdmin();
    }

    match /sales/{saleId} {
      allow read: if isStaff();
      // Staff can create sales
      allow create: if isStaff();
      // Only admins can update or delete sales
      allow update, delete: if isAdmin();
    }

    match /customers/{customerId} {
      allow read, create, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isStaff();
      allow update, delete: if false; // Logs are immutable
    }

    match /promotions/{promotionId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
